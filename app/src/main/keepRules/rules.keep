# R8 rules for the release build. AGP passes every file in src/main/keepRules to R8.

# LiteRT (TensorFlow Lite) loads its native runtime through JNI and reads the model through
# reflection-like lookups, so its classes and native method names must survive shrinking.
-keep class org.tensorflow.lite.** { *; }
-keep class com.google.ai.edge.litert.** { *; }
-dontwarn org.tensorflow.lite.**
-dontwarn com.google.ai.edge.litert.**

# The face feature's own routes are @Serializable data classes used by Navigation's type-safe routes.
-keepclassmembers class com.sumonlogs.faceverify.** {
    *** Companion;
}
-keepclasseswithmembers class com.sumonlogs.faceverify.** {
    kotlinx.serialization.KSerializer serializer(...);
}

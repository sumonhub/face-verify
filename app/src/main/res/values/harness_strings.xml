    <string name="harness_consent_title">Share anonymous test data?</string>
    <string name="harness_consent_body">To improve face checks, this test build can send numbers from each check: scores, timings, light, phone model and crash reports. It never sends photos, names or face data, and you can turn it off any time in the app.</string>

<?xml version="1.0" encoding="utf-8"?>
<!-- Face templates are encrypted with a device-bound Keystore key; never back them up or transfer them. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/face_templates.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/face_templates.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
